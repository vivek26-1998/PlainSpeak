ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort for Claude calls: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback ("default" or empty to disable)
ANTHROPIC_FALLBACKS=default
RESON8_API_KEY=
PORT=3001
# Optional: where case JSON and uploads are stored
PLAINSPEAK_DATA_DIR=data
